# Also signs JWTs (HS256). Production requires 32+ bytes — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
DEBUG=False
DATABASE_URL=postgresql://table_mate_user:table_mate_pass@localhost:5432/table_mate
DB_CONN_MAX_AGE=60
REDIS_URL=redis://localhost:6379/0
DJANGO_READ_DOT_ENV_FILE=True
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated. Must list every origin the frontend is served from, and each
# value must also be registered as an Authorized redirect URI in the Google
# Cloud Console (APIs & Services > Credentials). A served origin missing here is
# rejected before reaching Google; one missing in the Console is rejected by Google.
GOOGLE_ALLOWED_REDIRECT_URIS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
